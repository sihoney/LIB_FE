		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@mui/icons-material": "7.3.11",
		"@mui/material": "7.3.11",
		"@mui/x-date-pickers": "^8.29.5",
		"@tanstack/react-query": "5.103.1",
		"@tanstack/react-router": "1.170.38",
		"axios": "1.20.0",
		"clsx": "2.1.1",
		"dayjs": "^1.11.23",
		"es-toolkit": "1.52.0",
		"material-react-table": "3.2.1",
		"react": "^19.3.0",
