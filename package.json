		"@tanstack/router-plugin": "1.168.40",
		"@types/node": "^24.13.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"msw": "2.15.0",
		"oxlint": "^1.81.0",
		"prettier": "^3.9.8",
		"tailwindcss": "4.3.3",
		"typescript": "~5.9.3",
